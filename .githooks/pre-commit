#!/bin/sh
# Sanitize machine-specific paths out of project.pros before every commit.
# Enabled locally via: git config core.hooksPath .githooks (see .githooks/README.md)

if [ -f project.pros ]; then
    if command -v python3 >/dev/null 2>&1; then
        PY=python3
    else
        PY=python
    fi

    "$PY" scripts/sanitize_project_pros.py || exit 1
    git add project.pros
fi
